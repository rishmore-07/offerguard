# ==========================================
# OfferGuard AI Environment Configuration
# ==========================================

# Server Settings
HOST=127.0.0.1
PORT=8000

# Inference Provider Selection:
#   "baseline"      -> Local Scikit-learn TF-IDF + Logistic Regression (Recommended default)
#   "autoscientist" -> Remote Adaption Labs AutoScientist HTTP Inference API
#   "demo"          -> Heuristic Rule-Based Demo Mode (No model artifacts loaded)
MODEL_PROVIDER=baseline

# Adaption AutoScientist Configuration (Used when MODEL_PROVIDER=autoscientist)
AUTOSCIENTIST_API_URL=https://api.adaptionlab.com/v1/inference/your-run-id
AUTOSCIENTIST_API_KEY=your_adaption_api_key_here
MODEL_TIMEOUT=10.0

# Paths (Optional overrides)
# OFFERGUARD_MODEL_PATH=ml/models/offerguard_baseline.joblib
# OFFERGUARD_METRICS_PATH=ml/metrics/baseline_evaluation.json

